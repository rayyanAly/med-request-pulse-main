.files input {
    /*outline: 2px dashed #92b0b3;*/
    outline-offset: -10px;
    -webkit-transition: outline-offset .15s ease-in-out, background-color .15s linear;
    transition: outline-offset .15s ease-in-out, background-color .15s linear;
    padding: 90px 0px 65px 15%;
    text-align: center !important;
    margin: 0;
    width: 94% !important;
    color: transparent;
}
.files input:focus {
    outline: 2px dashed #92b0b3;
    outline-offset: -10px;
    -webkit-transition: outline-offset .15s ease-in-out, background-color .15s linear;
    transition: outline-offset .15s ease-in-out, background-color .15s linear;
    border: 1px solid #92b0b3;
}
.files {
    position: relative
}
.files:after {

    pointer-events: none;
    position: absolute;
    top: 20px;
    left: 0px;
    left: 0;
    width: 50px;
    right: 0;
    height: 56px;
    content: "";
    background-image: url('../images/cloud-computing.png');
    display: block;
    margin: 0 auto;
    background-size: 100%;
    background-repeat: no-repeat;

}
.color input {
    background-color: #fff;
}
.color input[type=button] {
    background-color: red;
}
.files:before {
    position: absolute;
    bottom: 10px;
    left: 0;
    pointer-events: none;
    width: 100%;
    right: 0;
    height: 57px;
    content: "";
    display: block;
    margin: 0 auto;
    color: #2ea591;
    font-weight: 600;
    text-transform: capitalize;
    text-align: center;
}
